[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"

[libraries]
linux.debug.x86_64 = "res://addons/godot_bt_native/bin/libgodot_bt_native.debug.so"
linux.release.x86_64 = "res://addons/godot_bt_native/bin/libgodot_bt_native.release.so"
linux.debug.arm64 = "res://addons/godot_bt_native/bin/libgodot_bt_native.debug.so"
linux.release.arm64 = "res://addons/godot_bt_native/bin/libgodot_bt_native.release.so"
windows.debug.x86_64 = "res://addons/godot_bt_native/bin/libgodot_bt_native.debug.dll"
windows.release.x86_64 = "res://addons/godot_bt_native/bin/libgodot_bt_native.release.dll"
macos.debug = "res://addons/godot_bt_native/bin/libgodot_bt_native.debug.dylib"
macos.release = "res://addons/godot_bt_native/bin/libgodot_bt_native.release.dylib"
